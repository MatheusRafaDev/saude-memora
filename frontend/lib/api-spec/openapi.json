        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/pacientes/me/contato": {
      "patch": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContatoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ficha-medica/me": {
      "get": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FichaMedica"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/documents/upload": {
      "post": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/documents/count": {
      "get": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/documents/{id}": {
      "get": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/reports/generate": {
      "get": {
        "tags": [
          "SaudeMemora.Api"
        ],
        "parameters": [
          {
            "name": "months",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CondicaoMedica": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "tem": {
            "type": "boolean"
          },
          "detalhes": {
            "type": "string"
          }
        }
      },
      "ContatoDto": {
        "required": [
          "telefone",
          "endereco"
        ],
        "type": "object",
        "properties": {
          "telefone": {
            "type": "string",
            "nullable": true
          },
          "endereco": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FichaMedica": {
        "required": [
          "patientId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "patientId": {
            "type": "string"
          },
          "historicoFamiliar": {
            "type": "string"
          },
          "cirurgias": {
            "type": "string"
          },
          "fuma": {
            "type": "boolean"
          },
          "bebe": {
            "type": "boolean"
          },
          "habitosGerais": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "condicoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CondicaoMedica"
            }
          },
          "outrasDoencas": {
            "type": "string"
          }
        }
      },
      "LoginPacienteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "MedicamentoContinuoDto": {
        "required": [
          "nome",
          "dosagem",
          "horario"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "dosagem": {
            "type": "string"
          },
          "horario": {
            "type": "string"
          }
        }
      },
      "PerfilMedicoDto": {
        "required": [
          "tipoSanguineo",
          "doadorOrgaos",
          "alergias",
          "doencasCronicas",
          "medicamentosContinuos"
        ],
        "type": "object",
        "properties": {
          "tipoSanguineo": {
            "type": "string",
            "nullable": true
          },
          "doadorOrgaos": {
            "type": "boolean",
            "nullable": true
          },
          "alergias": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "doencasCronicas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "medicamentosContinuos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MedicamentoContinuoDto"
            },
            "nullable": true
          }
        }
      },
      "RegisterPacienteDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "dataNascimento": {
            "type": "string"
          },
          "sexo": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "SaudeMemora.Api"
    }
  ]
}