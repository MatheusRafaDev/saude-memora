# Stage 1: Build da aplicação .NET 9
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copiar arquivos de projeto e restaurar dependências
COPY SaudeMemora.slnx ./
COPY SaudeMemora.Api/SaudeMemora.Api.csproj SaudeMemora.Api/
COPY SaudeMemora.Application/SaudeMemora.Application.csproj SaudeMemora.Application/
COPY SaudeMemora.Domain/SaudeMemora.Domain.csproj SaudeMemora.Domain/
COPY SaudeMemora.Infrastructure/SaudeMemora.Infrastructure.csproj SaudeMemora.Infrastructure/
RUN dotnet restore SaudeMemora.Api/SaudeMemora.Api.csproj

# Copiar o código fonte e os catálogos (data/ e CID/)
COPY . ./
WORKDIR /src/SaudeMemora.Api
RUN dotnet publish -c Release -o /app/publish

# Stage 2: Runtime ASP.NET Core
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Instalar curl para diagnósticos e healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

# A Vercel encaminha o tráfego dinamicamente para a porta $PORT (geralmente 80 ou 8080)
ENV PORT=80
ENV ASPNETCORE_HTTP_PORTS=80;8080
EXPOSE 80 8080

# Executa com usuário root no contêiner para garantir permissão irrestrita de bind em portas baixas (<1024)
USER root

# Inicializa o ASP.NET Core escutando na porta $PORT e também na 80/8080
ENTRYPOINT ["/bin/sh", "-c", "export ASPNETCORE_URLS=\"http://+:${PORT:-80};http://+:8080\"; exec dotnet SaudeMemora.Api.dll"]
