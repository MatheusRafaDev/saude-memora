# Local development defaults
PORT=8080
ASPNETCORE_URLS=http://+:8080
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=saudeMemora
REDIS_CONNECTION_STRING=localhost:6379

# --- Autenticação -----------------------------------------------------------
# Obrigatório. Sem valor válido a API NÃO inicia (não existe mais segredo padrão).
# Gere com: openssl rand -base64 48
JWT_SECRET_KEY=replace-with-a-long-random-secret-32-chars
JWT_ISSUER=saude-memora
JWT_AUDIENCE=saude-memora
JWT_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------------------
# Allowlist explícita de origens. Não existe mais curinga para *.vercel.app.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origens dinâmicas (ex.: previews da Vercel). Opcional e vazio por padrão.
# O curinga precisa ser um rótulo inteiro no início de um domínio concreto.
# Exemplo: https://*.preview.seu-time.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Armazenamento e e-mail -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
BREVO_FROM_EMAIL=nao-responda@saudememora.com.br

# --- Provedores de IA e OCR -------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=
GEMINI_MODEL=
OCR_SPACE_API_KEY=

# --- Catálogos --------------------------------------------------------------
CATALOGO_IMPORT_TOKEN=
BULARIO_API_BASE_URL=https://consultas.anvisa.gov.br/
BULARIO_API_PAGE_SIZE=1
BULARIO_API_TIMEOUT_SECONDS=15
CID10_CATALOG_PATH=
CNES_CATALOG_PATH=

# --- Processamento em segundo plano -----------------------------------------
# Documentos processados em paralelo por instância (1 a 16; padrão 3).
DOCUMENT_WORKER_CONCURRENCY=3
# Aplicar migrações de banco no startup (false = migrar em job separado).
RUN_MIGRATIONS_ON_STARTUP=true
# URL pública usada pelo ping anti-hibernação. Vazio desativa o worker.
PUBLIC_API_URL=

# --- Ficha de emergência ----------------------------------------------------
# Validade do token em horas (1 a 168; padrão 12). O token dá acesso anônimo a
# dados clínicos e viaja em URL/QR code, então a janela deve ser curta.
EMERGENCIA_TOKEN_HORAS_EXPIRACAO=12

# IPs/CIDRs do proxy reverso confiável; deixe vazio quando a API não estiver atrás dele.
TRUSTED_PROXIES=
